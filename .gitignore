# ====================================================================
# Decision Twin AI — .gitignore
# ====================================================================

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
.Python
develop-eggs/
lib/
lib64/
sdist/
var/
wheels/
pip-wheel-metadata/

# ── Virtual Environments ───────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Testing & Coverage ────────────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node.js / Frontend ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
frontend/dist/
frontend/.vite/

# ── Environment Variables ──────────────────────────────────────────
.env
.env.local
.env.development
.env.test
.env.production
!.env.example

# ── Docker ─────────────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── ML Artifacts ──────────────────────────────────────────────────
*.joblib
*.pkl
*.pickle
*.h5
*.onnx
mlruns/
mlflow-artifacts/
*.faiss
*.index

# ── Alembic ────────────────────────────────────────────────────────
# Track migrations, but ignore auto-generated stamp files
alembic/versions/.keep

# ── Misc ───────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.db
*.sqlite
*.sqlite3
.gemini/

# ── Security Audit Artifacts ───────────────────────────────────────
# Never commit internal security reports to version control
.security/
