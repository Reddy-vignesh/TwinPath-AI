# ====================================================================
# Decision Twin AI — Environment Variables
# ====================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ====================================================================

# ── Application ────────────────────────────────────────────────────
APP_NAME=Decision Twin AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=decisiontwin
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=decisiontwin_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── JWT Authentication ─────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-secure-random-string-of-at-least-64-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Redis (optional, for production rate limiting) ─────────────────
# REDIS_URL=redis://localhost:6379/0

# ── ML Models ──────────────────────────────────────────────────────
ML_MODELS_DIR=./ml_models
FAISS_INDEX_PATH=./ml_models/career_index.faiss

# ── Uvicorn ────────────────────────────────────────────────────────
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
